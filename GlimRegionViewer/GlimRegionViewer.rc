// GlimRegionViewer.rc
// NOTE: this file is ASCII/CP949 encoded (no UTF-8 BOM) to avoid rc.exe RC2135.
// Keep captions in English. Most controls are created dynamically in OnInitDialog.

#include "resource.h"
#include "afxres.h"

#ifdef APSTUDIO_INVOKED
1 TEXTINCLUDE
BEGIN
    "resource.h\0"
END

2 TEXTINCLUDE
BEGIN
    "#include ""afxres.h""\r\n"
    "\0"
END

3 TEXTINCLUDE
BEGIN
    "\r\n"
    "\0"
END
#endif

/////////////////////////////////////////////////////////////////////////////
// Dialog

IDD_GLIMREGIONVIEWER_DIALOG DIALOGEX 0, 0, 660, 430
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Glim Region Viewer"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Ready", IDC_STATIC_STATUS, 7, 415, 646, 11
END

/////////////////////////////////////////////////////////////////////////////
// Version
//  Keep strings ASCII/English (rc.exe reads this file as CP949).

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "GLIM"
            VALUE "FileDescription", "Glim Region Viewer"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "GlimRegionViewer.exe"
            VALUE "LegalCopyright", "Copyright (C) GLIM"
            VALUE "OriginalFilename", "GlimRegionViewer.exe"
            VALUE "ProductName", "Glim Region Viewer"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
